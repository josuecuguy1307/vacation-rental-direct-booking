# =====================================================================
#  ENVIRONMENT VARIABLES
#
#  1) Copy this file:        cp .env.example .env.local
#  2) Fill in YOUR OWN keys. On Vercel, set them under
#     Project → Settings → Environment Variables (do NOT commit .env.local).
#  3) Values like "TU_..._AQUI" ("YOUR_..._HERE") count as NOT configured: if a
#     REQUIRED variable is missing, the app stops with a message saying which one.
#
#  [REQUIRED] = the site, or that feature, does not work without it.
#  [OPTIONAL] = it has a safe behavior if you leave it empty.
#  Never commit .env.local to GitHub (it is already in .gitignore).
# =====================================================================


# ── SUPABASE (database + authentication + files) ─────────────────────
# Create a free project at https://supabase.com and go to Project Settings → API.

# [REQUIRED] Your project URL (Project URL).
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# [REQUIRED] Public "anon" key. Safe for the browser; RLS protects the data.
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# [REQUIRED] "service_role" key: bypasses RLS. SECRET, server only; never in the browser.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI


# ── SITE AND SECURITY ────────────────────────────────────────────────

# [REQUIRED] Public URL of your site, without a trailing "/". Used for the links in
# emails, payments and reviews. Locally: http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# [REQUIRED] Secret used to sign links (confirm a payment from the email, snack and
# review links) and webhooks. Generate one: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=TU_SECRETO_AQUI

# [REQUIRED] Secret for the cron jobs. Vercel Cron sends it by itself as
# "Authorization: Bearer <CRON_SECRET>". Without it the cron endpoints answer 401.
# Generate one: openssl rand -hex 32
CRON_SECRET=TU_CRON_SECRET_AQUI

# [REQUIRED to use the panel; empty = panel disabled] Secret path of the admin panel,
# e.g. "/manage-x7k2p9" (starts with "/", 6+ letters/digits). Without it the panel is
# DISABLED (404). Do not publish it. The panel is served at that path.
ADMIN_BASE_PATH=

# [REQUIRED to use the panel; empty = nobody is admin] Emails allowed as administrators,
# comma-separated. Create them with: npx tsx scripts/create-owner.mts you@example.com
ADMIN_EMAILS=

# [OPTIONAL] Separate secrets for the snack / review links. If left empty,
# INTERNAL_WEBHOOK_SECRET is used.
# SNACK_TOKEN_SECRET=
# REVIEW_TOKEN_SECRET=

# [OPTIONAL] true = enables /api/admin/test/fast-forward (testing only). NEVER in production.
ENABLE_TEST_ROUTES=false


# ── BOOKINGS ─────────────────────────────────────────────────────────

# [OPTIONAL] Hours after which an unpaid pending booking is cancelled and its dates
# freed (expire-pending cron). Default: 24.
RESERVATION_EXPIRY_HOURS=24

# [OPTIONAL] When the balance is collected if the deposit is below 100%:
# "before_checkin" (automatic link the day before) | "manual" (you collect it yourself).
BALANCE_DUE_TIMING=before_checkin


# ── PAYMENTS ─────────────────────────────────────────────────────────
# Pick ONE active gateway. bank_transfer needs no third-party account.

# [REQUIRED] bank_transfer | payphone | pichincha
#   bank_transfer = bank transfer with proof of payment (recommended to start)
#   payphone      = card payments (Payphone, Ecuador; replace with another gateway, see README)
#   pichincha     = bank payment-button sample integration
PAYMENT_PROVIDER=bank_transfer

# Your account details for transfers (shown to the guest; they can also be edited from
# the panel → Settings). With PAYMENT_PROVIDER=bank_transfer, fill these in.
BANK_NAME=TU_BANCO_AQUI                   # bank name
BANK_ACCOUNT_TYPE=TU_TIPO_DE_CUENTA_AQUI  # e.g. Savings / Checking
BANK_ACCOUNT_NUMBER=TU_NUMERO_DE_CUENTA_AQUI
BANK_ACCOUNT_HOLDER=TU_NOMBRE_TITULAR_AQUI
BANK_HOLDER_ID=TU_DOCUMENTO_TITULAR_AQUI  # holder's national ID / tax ID

# Payphone — only if PAYMENT_PROVIDER=payphone.
# Create an app at https://appdeveloper.payphonetodoesposible.com
PAYPHONE_TOKEN=TU_PAYPHONE_TOKEN_AQUI        # the app's token — SERVER only
PAYPHONE_STORE_ID=TU_STORE_ID_AQUI           # id of the store linked to the app
NEXT_PUBLIC_PAYPHONE_TOKEN=TU_PAYPHONE_TOKEN_PUBLICO_AQUI  # the box's browser token (use a restricted token if Payphone offers one)
# PAYPHONE_CONFIRM_URL=                      # [OPTIONAL] override of the confirmation endpoint

# Bank gateway — only if PAYMENT_PROVIDER=pichincha (your bank provides these when it
# enables the service).
PICHINCHA_API_URL=
PICHINCHA_API_KEY=
PICHINCHA_API_SECRET=
PICHINCHA_POS_ID=
# true = local simulator, no credentials (development only)
PICHINCHA_STUB_MODE=false


# ── EMAIL ────────────────────────────────────────────────────────────

# [REQUIRED] Sender. Must be verified with your provider. E.g. "My House <bookings@your-domain.com>"
EMAIL_FROM=TU_REMITENTE_AQUI

# [REQUIRED] resend | smtp
EMAIL_PROVIDER=resend

# Resend (https://resend.com → API Keys) — if EMAIL_PROVIDER=resend
RESEND_API_KEY=TU_RESEND_API_KEY_AQUI

# SMTP — if EMAIL_PROVIDER=smtp (e.g. Gmail with an "app password")
SMTP_HOST=                      # e.g. smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# [OPTIONAL] Email where the host receives notifications (new booking, proof of payment,
# etc.). It can also be set from the panel.
OWNER_EMAIL=

# [OPTIONAL] instant = one notice per event | daily = a daily summary of automatic messages.
OWNER_DIGEST=instant

# [OPTIONAL, only for scripts/test-emails.mts] Where to send the test emails.
# TEST_EMAIL_TO=you@example.com


# ── GUEST MESSAGES ───────────────────────────────────────────────────

# [OPTIONAL] Link to leave reviews (Google Business, etc.). Empty = the built-in review page is used.
REVIEW_LINK=

# [OPTIONAL] Wifi sent in the arrival message (can also be set from the panel).
WIFI_NAME=
WIFI_PASSWORD=


# ── WHATSAPP (Meta Cloud API) — all OPTIONAL ─────────────────────────
# Without these variables no WhatsApp messages are sent (everything else keeps working).
# Set it up at https://developers.facebook.com → your app → WhatsApp → API Setup.

WHATSAPP_TOKEN=                 # PERMANENT system-user token (not the temporary 24 h one)
WHATSAPP_PHONE_NUMBER_ID=       # "Phone number ID" of the sending number
OWNER_WHATSAPP=                 # host number that receives notices: digits with country code, no "+"
